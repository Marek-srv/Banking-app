model loan_requests {
  loan_request_id           BigInt        @id @default(autoincrement())
  customer_id               BigInt
  requested_amount          Decimal       @db.Decimal(19, 4)
  requested_duration_months Int
  loan_type                 String        @db.VarChar(50)
  loan_subtype              String?       @db.VarChar(50)
  purpose                   String        @db.VarChar(500)
  requested_interest_rate   Decimal?      @db.Decimal(8, 4)
  status                    RequestStatus @default(PENDING)
  reviewed_by               BigInt?
  reviewed_at               DateTime?     @db.Timestamp(6)
  approved_amount           Decimal?      @db.Decimal(19, 4)
  approved_duration_months  Int?
  approved_interest_rate    Decimal?      @db.Decimal(8, 4)
  rejection_reason          String?       @db.VarChar(500)
  admin_note                String?
  created_at                DateTime      @default(now()) @db.Timestamp(6)
  updated_at                DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  customers                 customers     @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_request_customer")
  reviewer                  users?        @relation("loan_requests_reviewed_byTousers", fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_request_reviewed_by")
  loans                     loans?

  @@index([customer_id], map: "idx_loan_request_customer")
  @@index([customer_id, status], map: "idx_loan_request_customer_status")
  @@index([status, created_at], map: "idx_loan_request_status_created")
}

model card_requests {
  card_request_id  BigInt        @id @default(autoincrement())
  customer_id      BigInt
  account_id       BigInt
  card_type        String        @db.VarChar(30)
  card_variant     String?       @db.VarChar(50)
  notes            String?       @db.VarChar(500)
  status           RequestStatus @default(PENDING)
  reviewed_by      BigInt?
  reviewed_at      DateTime?     @db.Timestamp(6)
  rejection_reason String?       @db.VarChar(500)
  approved_card_id BigInt?       @unique
  created_at       DateTime      @default(now()) @db.Timestamp(6)
  updated_at       DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  customers        customers     @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_card_request_customer")
  accounts         accounts      @relation(fields: [account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_card_request_account")
  reviewer         users?        @relation("card_requests_reviewed_byTousers", fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_card_request_reviewed_by")
  approved_card    cards?        @relation(fields: [approved_card_id], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_card_request_approved_card")

  @@index([customer_id, status], map: "idx_card_request_customer_status")
  @@index([account_id, status], map: "idx_card_request_account_status")
  @@index([status, created_at], map: "idx_card_request_status_created")
}

model loans {
  loan_id                     BigInt               @id @default(autoincrement())
  customer_id                 BigInt
  account_id                  BigInt               @unique
  loan_request_id             BigInt               @unique
  principal_amount            Decimal              @db.Decimal(19, 4)
  outstanding_principal       Decimal              @db.Decimal(19, 4)
  interest_rate               Decimal              @db.Decimal(8, 4)
  duration_months             Int
  emi_amount                  Decimal              @db.Decimal(19, 4)
  loan_type                   String               @db.VarChar(50)
  loan_subtype                String?              @db.VarChar(50)
  status                      LoanStatus           @default(APPROVED)
  approved_at                 DateTime?            @db.Timestamp(6)
  approved_by                 BigInt?
  disbursed_at                DateTime?            @db.Timestamp(6)
  disbursed_by                BigInt?
  disbursement_transaction_id BigInt?              @unique
  auto_debit_enabled          Boolean              @default(false)
  auto_debit_account_id       BigInt?
  closed_at                   DateTime?            @db.Timestamp(6)
  created_at                  DateTime             @default(now()) @db.Timestamp(6)
  updated_at                  DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  customers                   customers            @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_customer")
  accounts                    accounts             @relation(fields: [account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_account")
  auto_debit_account          accounts?            @relation("loans_auto_debit_account", fields: [auto_debit_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_auto_debit_account")
  disbursement_transaction    transactions?        @relation("loan_disbursement_transaction", fields: [disbursement_transaction_id], references: [transaction_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_disbursement_transaction")
  loan_requests               loan_requests        @relation(fields: [loan_request_id], references: [loan_request_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_request")
  approver                    users?               @relation("loans_approved_byTousers", fields: [approved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_approved_by")
  disburser                   users?               @relation("loans_disbursed_byTousers", fields: [disbursed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_loan_disbursed_by")
  emi_schedules               loan_emi_schedules[]

  @@index([customer_id], map: "idx_loan_customer")
  @@index([status], map: "idx_loan_status")
  @@index([auto_debit_account_id], map: "idx_loan_auto_debit_account")
}

model loan_emi_schedules {
  emi_schedule_id     BigInt        @id @default(autoincrement())
  loan_id             BigInt
  installment_number  Int
  due_date            DateTime      @db.Date
  principal_component Decimal       @db.Decimal(19, 4)
  interest_component  Decimal       @db.Decimal(19, 4)
  total_emi           Decimal       @db.Decimal(19, 4)
  amount_paid         Decimal       @default(0) @db.Decimal(19, 4)
  late_fee            Decimal       @default(0) @db.Decimal(19, 4)
  status              EmiStatus     @default(PENDING)
  paid_at             DateTime?     @db.Timestamp(6)
  transaction_id      BigInt?
  created_at          DateTime      @default(now()) @db.Timestamp(6)
  updated_at          DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  loans               loans         @relation(fields: [loan_id], references: [loan_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_emi_schedule_loan")
  transactions        transactions? @relation(fields: [transaction_id], references: [transaction_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_emi_schedule_transaction")

  @@unique([loan_id, installment_number], map: "uq_emi_schedule_installment")
  @@index([loan_id], map: "idx_emi_schedule_loan")
  @@index([due_date, status], map: "idx_emi_schedule_due_status")
}

model request_status_history {
  request_status_history_id BigInt         @id @default(autoincrement())
  request_type              RequestType
  request_id                BigInt
  previous_status           RequestStatus?
  new_status                RequestStatus
  changed_by                BigInt?
  reason                    String?        @db.VarChar(500)
  created_at                DateTime       @default(now()) @db.Timestamp(6)
  users                     users?         @relation("request_status_history_changed_byTousers", fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_status_history_changed_by")

  @@index([request_type, request_id, created_at], map: "idx_request_status_history_request")
  @@index([new_status, created_at], map: "idx_request_status_history_status")
}
