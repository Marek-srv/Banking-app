{
  "name": "backend",
  "version": "1.0.0",
  "description": "Banking application API",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "test": "tsx --test --test-concurrency=1 tests/email-otp.test.ts tests/account-recovery.test.ts tests/banking-v1.test.ts tests/banking-integrity.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/banking-v1.test.ts",
    "test:integrity": "tsx --test --test-concurrency=1 tests/banking-integrity.test.ts",
    "test:phase4": "tsx --test --test-concurrency=1 tests/phase4-account-servicing.test.ts",
    "test:phase5": "tsx --test --test-concurrency=1 tests/phase5-loans.test.ts",
    "test:phase9": "tsx --test --test-concurrency=1 tests/phase9-v1-e2e.test.ts",
    "stress:typecheck": "tsc -p stress-tests/tsconfig.json",
    "stress:test": "tsx stress-tests/run-artillery.ts load 25",
    "stress:25": "tsx stress-tests/run-artillery.ts load 25",
    "stress:50": "tsx stress-tests/run-artillery.ts load 50",
    "stress:100": "tsx stress-tests/run-artillery.ts load 100",
    "stress:250": "tsx stress-tests/run-artillery.ts load 250",
    "stress:500": "tsx stress-tests/run-artillery.ts load 500",
    "stress:concurrency": "tsx stress-tests/run-artillery.ts concurrency 100",
    "stress:idempotency": "tsx stress-tests/run-artillery.ts idempotency 25",
    "stress:invalid": "tsx stress-tests/run-artillery.ts invalid 10",
    "stress:otp": "artillery run stress-tests/auth-otp/otp-stress.yml",
    "stress:integrity": "tsx stress-tests/check-banking-integrity.ts",
    "stress:cleanup": "tsx stress-tests/cleanup.ts",
    "seed:south-india": "tsx scripts/populate-south-india.ts",
    "seed:south-india:verify": "tsx scripts/verify-south-india.ts",
    "seed:local-admin": "tsx scripts/seed-local-admin.ts",
    "admin:verify": "tsx scripts/verify-admin-v1.ts",
    "admin:v1.1:verify": "tsx scripts/verify-admin-v1-1.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "artillery": "^2.0.33",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
